---
import { ArrowDown, ArrowUpRight, ChevronRight } from "lucide-react";
---
<section class="intro marketing-section" aria-labelledby="intro-title">
  <a class="wordmark" href="/">cxstatusline</a>
  <p class="prompt-line"><ChevronRight aria-hidden="true" size={16} strokeWidth={2} /> Configure my Codex statusline</p>
  <div class="response-line">
    <span class="response-mark" aria-hidden="true">•</span>
    <div>
      <h1 id="intro-title">Keep the whole session<br /><span>in sight.</span></h1>
      <p class="lede desktop-only">Context, Git, and usage stay below your prompt. Edit the live layout here, then install it locally.</p>
      <p class="lede mobile-only">Context, Git, and usage stay below your prompt. Open this page on desktop to try the live layout editor.</p>
      <div class="intro-actions desktop-only">
        <a href="#install">Install cxstatusline <ArrowDown aria-hidden="true" size={14} strokeWidth={2} /></a>
        <a href="https://github.com/adrijshikhar/cxstatusline">View source <ArrowUpRight aria-hidden="true" size={14} strokeWidth={2} /></a>
      </div>
      <div class="intro-actions mobile-only">
        <a href="#features">See how it works <ArrowDown aria-hidden="true" size={14} strokeWidth={2} /></a>
        <a href="https://github.com/adrijshikhar/cxstatusline">View source <ArrowUpRight aria-hidden="true" size={14} strokeWidth={2} /></a>
      </div>
    </div>
  </div>
</section>
