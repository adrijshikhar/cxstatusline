<section id="playground" aria-labelledby="playground-title">
<div id="desktop-playground">
<div class="playground-heading">
<div>
<h2 id="playground-title">Make it yours.</h2>
<p>Edit your layout, then Save &amp; Exit to preview it.</p>
</div>
<div class="actions">
<button id="boot" type="button" hidden>Retry playground</button>
<button id="edit" type="button" hidden>Edit statusline</button>
<button id="download" type="button" disabled>Download sample settings</button>
</div>
</div>
<p id="status" class="status" role="status" aria-live="polite">Loading your sample layout…</p>
<p class="terminal-hint">Arrow keys and Enter to edit · Tab to leave the terminal.</p>
<div class="terminal-shell" aria-label="cxstatusline terminal">
<div id="chat-preview" hidden>
<label class="composer-label" for="demo-message">Try typing here <span>Demo only · no messages are sent.</span></label>
<textarea id="demo-message" rows="3" placeholder="Type a message to preview the composer…">
</textarea>
</div>
<div id="terminal">
</div>
</div>
<p class="note">Example layout with sample session data. Save inside the editor before downloading.</p>
</div>
</section>
