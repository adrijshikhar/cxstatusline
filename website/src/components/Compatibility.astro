---
import { ChevronDown } from "lucide-react";
import { supportedCodexReleases } from "../release-info";
import { Card } from "./ui/card";
import CopyFlagButton from "./CopyFlagButton";

const VISIBLE_COUNT = 6;
const primaryReleases = supportedCodexReleases.slice(0, VISIBLE_COUNT);
const olderReleases = supportedCodexReleases.slice(VISIBLE_COUNT);
const hasOlderReleases = olderReleases.length > 0;

const issueBody = [
  "### Requested Codex version",
  "<!-- e.g. 0.156.0 or the version you want supported -->",
  "",
  "### Platform / Architecture",
  "<!-- e.g. macOS (Apple Silicon), macOS (Intel), Linux (x64), Linux (arm64) -->",
  "",
  "### Current behavior / error (if attempted)",
  "<!-- e.g. output of `cxstatusline install --codex-version X.Y.Z` or `cxstatusline doctor` -->",
  "```",
  "",
  "```",
  "",
  "### Additional context",
  "<!-- Any notes on where this Codex build came from or why this version is needed -->",
].join("\n");

const requestVersionIssueUrl = `https://github.com/adrijshikhar/cxstatusline/issues/new?template=request-version.md&title=${encodeURIComponent("Support request: Codex v")}&labels=version-request&body=${encodeURIComponent(issueBody)}`;
---

<section id="compatibility" class="marketing-section content-section" aria-labelledby="compatibility-title">
  <div class="compatibility-header">
    <div class="compatibility-title-group">
      <h2 id="compatibility-title">Compatibility matrix.</h2>
      <p class="compatibility-desc">
        Any version of cxstatusline can install and patch any supported Codex release on macOS and Linux. Select your version interactively during installation or target one directly with <code>--codex-version</code>.
      </p>
    </div>
    <div class="compatibility-hint">
      <span class="hint-label">Targeted install command:</span>
      <code class="hint-code">cxstatusline install --codex-version &lt;release&gt;</code>
    </div>
  </div>

  <Card className="compatibility-card p-0 overflow-hidden">
    <div class="compatibility-labels" aria-hidden="true">
      <span>Codex Release</span>
      <span>Supported Platforms</span>
      <span>Install Flag</span>
      <span class="text-right">Status</span>
    </div>
    <ul class="compatibility-rows">
      {primaryReleases.map((release) => (
        <li class="compatibility-row">
          <div class="flex items-center gap-2">
            <code>{release.version}</code>
            {release.isLatest && (
              <span class="rounded border border-[var(--line)] bg-[var(--surface-strong)] px-2 py-0.5 text-xs text-[var(--accent)]" title="Latest supported Codex CLI release">
                Latest
              </span>
            )}
          </div>
          <div class="compatibility-platforms">
            <div class="platform-badges">
              {release.platforms.map((platform) => (
                <span
                  class="platform-badge"
                  title={`${platform.name} (${platform.arch})`}
                >
                  {platform.name}
                </span>
              ))}
            </div>
          </div>
          <div class="compatibility-flag">
            <code>--codex-version {release.version}</code>
            <CopyFlagButton client:load text={`--codex-version ${release.version}`} />
          </div>
          <div class="compatibility-status">
            <a
              href={release.releaseUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`compatibility-badge compatibility-badge-${release.type}`}
              title={`View ${release.version} release on GitHub`}
            >
              <span>{release.status}</span>
              <span aria-hidden="true" class="release-arrow">↗</span>
            </a>
          </div>
        </li>
      ))}
    </ul>

    {hasOlderReleases && (
      <div id="compatibility-older" class="compatibility-older-wrapper" data-expanded="false">
        <div class="compatibility-older-inner">
          <ul class="compatibility-rows compatibility-older-rows">
            {olderReleases.map((release) => (
              <li class="compatibility-row">
                <div class="flex items-center gap-2">
                  <code>{release.version}</code>
                  {release.isLatest && (
                    <span class="rounded border border-[var(--line)] bg-[var(--surface-strong)] px-2 py-0.5 text-xs text-[var(--accent)]" title="Latest supported Codex CLI release">
                      Latest
                    </span>
                  )}
                </div>
                <div class="compatibility-platforms">
                  <div class="platform-badges">
                    {release.platforms.map((platform) => (
                      <span
                        class="platform-badge"
                        title={`${platform.name} (${platform.arch})`}
                      >
                        {platform.name}
                      </span>
                    ))}
                  </div>
                </div>
                <div class="compatibility-flag">
                  <code>--codex-version {release.version}</code>
                  <CopyFlagButton client:load text={`--codex-version ${release.version}`} />
                </div>
                <div class="compatibility-status">
                  <a
                    href={release.releaseUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`compatibility-badge compatibility-badge-${release.type}`}
                    title={`View ${release.version} release on GitHub`}
                  >
                    <span>{release.status}</span>
                    <span aria-hidden="true" class="release-arrow">↗</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <button
        type="button"
        id="compatibility-toggle"
        class="compatibility-toggle-btn"
        aria-expanded="false"
        aria-controls="compatibility-older"
        data-count={olderReleases.length}
      >
        <span class="compatibility-toggle-label">Show {olderReleases.length} older versions</span>
        <span class="compatibility-toggle-range">({olderReleases[0]?.version} – {olderReleases[olderReleases.length - 1]?.version})</span>
        <ChevronDown aria-hidden="true" size={14} className="compatibility-toggle-icon" />
      </button>
    )}
    <div class="compatibility-footer">
      <a
        class="compatibility-link"
        href={requestVersionIssueUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Request a version <span>→</span>
      </a>
      <a class="compatibility-link" href="https://github.com/adrijshikhar/cxstatusline/releases">
        Browse all releases on GitHub <span>→</span>
      </a>
    </div>
  </Card>
</section>

<script>
  function setupCompatibilityToggle() {
    const toggleBtn = document.getElementById("compatibility-toggle");
    const olderSection = document.getElementById("compatibility-older");
    if (!toggleBtn || !olderSection) return;

    const count = toggleBtn.getAttribute("data-count") || "";
    const labelSpan = toggleBtn.querySelector(".compatibility-toggle-label");
    const rangeSpan = toggleBtn.querySelector(".compatibility-toggle-range");

    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      const nextState = !isExpanded;

      toggleBtn.setAttribute("aria-expanded", String(nextState));
      olderSection.setAttribute("data-expanded", String(nextState));

      if (labelSpan) {
        labelSpan.textContent = nextState
          ? "Show fewer versions"
          : `Show ${count} older versions`;
      }
      if (rangeSpan) {
        rangeSpan.style.display = nextState ? "none" : "";
      }
    });
  }

  setupCompatibilityToggle();
  document.addEventListener("astro:page-load", setupCompatibilityToggle);
</script>
