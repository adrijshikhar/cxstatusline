+                "cached_input_tokens": usage.map(|usage| usage.cached_input_tokens),
+                "five_hour": window(codex_limits.and_then(five_hour_status_window)),
+                "weekly": window(codex_limits.and_then(weekly_status_window)),
+            },
+            "session": {
