+#[test]
+fn cxstatusline_rows_survive_warning_and_menu_transitions() {
+    let mut composer = composer();
+    composer.set_cxstatusline_block(vec![
+        "CX row one".into(),
+        "CX row two".into(),
+        "CX row three".into(),
+    ]);
+    for draft in ["", "/", "", "hello", ""] {
+        composer.set_text_content(draft.into(), Vec::new(), Vec::new());
+        for count in [0, 3, 0] {
+            let screen = text(&render(&composer, /*width*/ 100, count));
+            for row in ["CX row one", "CX row two", "CX row three"] {
+                assert!(screen.contains(row), "missing {row}: {screen}");
+            }
+        }
+    }
+    insta::assert_snapshot!(
+        "cxstatusline_three_rows_with_warnings",
+        text(&render(&composer, /*width*/ 100, /*count*/ 3))
+    );
+}
