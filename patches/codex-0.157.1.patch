+            self.frame_requester.schedule_frame_in(remaining);
+            return;
+        }
+        self.cxstatusline_dirty = false;
+        self.refresh_status_line();
+    }
+
+    /// Requests fresh account limits for renderer payloads at most once per minute.
+    pub(super) fn cxstatusline_rate_limit_tick(&mut self, now: Instant) {
+        if self.cxstatusline_command.is_none()
+            || !self.should_prefetch_rate_limits()
+            || self.cxstatusline_rate_limit_pending
+        {
+            return;
+        }
+        if let Some(last_requested_at) = self.cxstatusline_rate_limit_last_requested_at {
+            let elapsed = now.saturating_duration_since(last_requested_at);
+            if elapsed < CXSTATUSLINE_RATE_LIMIT_REFRESH_INTERVAL {
+                self.frame_requester
+                    .schedule_frame_in(CXSTATUSLINE_RATE_LIMIT_REFRESH_INTERVAL - elapsed);
+                return;
+            }
+        }
+        self.cxstatusline_rate_limit_pending = true;
+        self.cxstatusline_rate_limit_last_requested_at = Some(now);
+        self.app_event_tx.send(AppEvent::RefreshRateLimits {
+            origin: crate::app_event::RateLimitRefreshOrigin::CxStatusLine,
+        });
+        self.frame_requester
+            .schedule_frame_in(CXSTATUSLINE_RATE_LIMIT_REFRESH_INTERVAL);
+    }
+
+    pub(crate) fn finish_cxstatusline_rate_limit_refresh(&mut self) {
+        self.cxstatusline_rate_limit_pending = false;
+        // The completed read changed the payload source; schedule one renderer run.
+        self.cxstatusline_dirty = true;
+    }
+
+    /// cxstatusline: draw the last complete shared block, if any. A poisoned lock leaves the
+    /// already-rendered block untouched, so callers do not replace it with partial/native output.
+    fn cxstatusline_draw_shared_cell(&mut self) -> bool {
+        let rendered = match self.cxstatusline_output.lock() {
+            Ok(guard) => guard.clone(),
+            Err(_) => return true,
+        };
+        let Some(rendered) = rendered else {
+            return false;
+        };
+        self.bottom_pane.set_cxstatusline_block(rendered);
+        self.bottom_pane.set_status_line_enabled(/*enabled*/ false);
+        self.set_status_line(/*status_line*/ None);
+        self.set_status_line_hyperlink(/*url*/ None);
+        true
+    }
+
+    fn cxstatusline_throttle_remaining(&self, now: Instant) -> Option<Duration> {
+        let last = self.cxstatusline_last_spawn_at?;
+        let elapsed = now.saturating_duration_since(last);
+        (elapsed < CXSTATUSLINE_MIN_INTERVAL).then(|| CXSTATUSLINE_MIN_INTERVAL - elapsed)
+    }
+
+    /// cxstatusline: spawn the renderer with a payload v1 snapshot, unless one is in flight or the
+    /// throttle window is open - then remember to run again. Mirrors `request_status_line_branch`.
+    fn cxstatusline_request_render(&mut self) {
+        let Some(argv) = self.cxstatusline_command.clone() else {
+            return;
+        };
+        let now = Instant::now();
+        if self.cxstatusline_pending.load(Ordering::Acquire)
+            || self.cxstatusline_throttle_remaining(now).is_some()
+        {
+            self.cxstatusline_dirty = true;
+            self.frame_requester
+                .schedule_frame_in(CXSTATUSLINE_MIN_INTERVAL);
+            return;
+        }
+        let payload = self.cxstatusline_payload_v1().to_string();
+        self.cxstatusline_pending.store(true, Ordering::Release);
+        self.cxstatusline_last_spawn_at = Some(now);
+        let output = self.cxstatusline_output.clone();
+        let pending = self.cxstatusline_pending.clone();
+        let fresh = self.cxstatusline_fresh.clone();
+        let frame_requester = self.frame_requester.clone();
+        tokio::spawn(async move {
+            if let Some(block) = cxstatusline_run(&argv, payload).await
+                && let Ok(mut guard) = output.lock()
+            {
+                *guard = Some(block);
+                fresh.store(true, Ordering::Release);
+            }
+            pending.store(false, Ordering::Release);
+            frame_requester.schedule_frame();
+        });
+    }
+
+    /// cxstatusline: typed snapshot of the git state behind the native git status-line items.
+    fn cxstatusline_git_v1(&self) -> serde_json::Value {
